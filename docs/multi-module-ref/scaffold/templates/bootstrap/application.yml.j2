spring:
  application:
    name: {{ svc }}

  # Nacos 配置中心（禁止 bootstrap.yml）；本地无 Nacos 时注释掉 config.import
#  config:
#    import:
#      - nacos:{{ svc }}.yml
  cloud:
    nacos:
      server-addr: ${NACOS_ADDR:localhost:8848}

  # 虚拟线程（Java 21 默认开启；生产禁止 synchronized）
  threads:
    virtual:
      enabled: true

  # 数据源（每服务独立 Database）
  datasource:
    url: jdbc:postgresql://${PG_HOST:localhost:5432}/{{ prefix }}_db
    username: ${PG_USER:postgres}
    password: ${PG_PASSWORD:postgres}
    hikari:
      maximum-pool-size: 20

  # Flyway
  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true

  # Problem Details（RFC 7807）
  mvc:
    problemdetails:
      enabled: true

# MyBatis-Plus
mybatis-plus:
  mapper-locations: classpath*:mapper/*.xml
  configuration:
    map-underscore-to-camel-case: true

# 可观测性
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,prometheus
  endpoint:
    health:
      probes:
        enabled: true
  tracing:
    sampling:
      probability: 1.0

server:
  port: 8080
  shutdown: graceful